{
  "dns": {
    "servers": ["1.1.1.1", "1.0.0.1"],
    "queryStrategy": "UseIP"
  },
  "routing": {
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "direct",
        "domain": [
          "geosite:ru",
          "geosite:gov-ru",
          "geosite:bank-ru"
        ]
      },
      {
        "type": "field",
        "outboundTag": "direct",
